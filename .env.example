# Dual-LLM configuration. The generator uses the DeepSeek direct API by default;
# the QC reviewer uses OpenRouter.
# Copy this file to .env and fill it in with your own keys (never commit .env).

# Generator (DeepSeek V4.1 Flash, DeepSeek direct API): outline, sections and revision.
# OpenRouter also supported by changing GENERATOR_BASE_URL/GENERATOR_MODEL.
# Get a DeepSeek key at https://platform.deepseek.com/api_keys
GENERATOR_API_KEY=your_deepseek_api_key_here
GENERATOR_BASE_URL=https://api.deepseek.com/v1
GENERATOR_MODEL=deepseek-flash

# QC reviewer (GLM 5.3 Flash): independent quality review, via OpenRouter.
# Get an OpenRouter key at https://openrouter.ai/keys
QC_API_KEY=your_openrouter_api_key_here
QC_BASE_URL=https://openrouter.ai/api/v1
QC_MODEL=z-ai/glm-5.3-flash

# Legacy fallback: LLM_API_KEY/LLM_BASE_URL/LLM_MODEL apply to a role when its
# role-specific variables are unset.
#LLM_API_KEY=your_api_key_here

# Optional: report title used on the DOCX title page.
#REPORT_TITLE=Market Entry Report: EdTech in Southeast Asia
