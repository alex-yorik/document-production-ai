# Required: API key for the LLM provider (OpenRouter).
# Get one at https://openrouter.ai/keys, then copy this file to .env and fill it in.
# The .env file is gitignored and must NEVER be committed.
LLM_API_KEY=your_openrouter_api_key_here

# Optional: override the LLM API endpoint and model.
#LLM_BASE_URL=https://openrouter.ai/api/v1
#LLM_MODEL=openai/gpt-4o-mini

# Optional: report title used on the DOCX title page.
#REPORT_TITLE=Market Entry Report: EdTech in Southeast Asia
