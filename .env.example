# Dual-LLM configuration. Both roles use OpenRouter by default.
# Get a key at https://openrouter.ai/keys, then copy this file to .env and fill it in.
# The .env file is gitignored and must NEVER be committed.

# Generator (GPT-4o-mini): outline, sections and revision.
GENERATOR_API_KEY=your_openrouter_api_key_here
GENERATOR_BASE_URL=https://openrouter.ai/api/v1
GENERATOR_MODEL=openai/gpt-4o-mini

# QC reviewer (GLM 5.3 Flash): independent quality review.
# May use the same OpenRouter key as the generator.
QC_API_KEY=your_openrouter_api_key_here
QC_BASE_URL=https://openrouter.ai/api/v1
QC_MODEL=z-ai/glm-5.3-flash

# Legacy fallback: LLM_API_KEY can be used when GENERATOR_API_KEY/QC_API_KEY are unset.
#LLM_API_KEY=your_openrouter_api_key_here

# Optional: report title used on the DOCX title page.
#REPORT_TITLE=Market Entry Report: EdTech in Southeast Asia
