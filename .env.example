# Required: API key for the LLM provider (DeepSeek).
# Get one at https://platform.deepseek.com, then copy this file to .env and fill it in.
# The .env file is gitignored and must NEVER be committed.
DEEPSEEK_API_KEY=your_api_key_here

# Optional: override the LLM API endpoint and model.
#DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#MODEL_NAME=deepseek-chat

# Optional: report title used on the DOCX title page.
#REPORT_TITLE=Market Entry Report: EdTech in Southeast Asia
